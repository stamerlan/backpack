root = true

[*]
charset = utf-8

[*.{py}]
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{css,html,js,json,rst,ts,tsx}]
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[Makefile]
indent_size = 8

[*.{c,cc,cpp,h,hpp}]
indent_style = tab
indent_size = 8
tab_width = 8

[*.{vcxproj,filters,slnx,manifest}]
indent_size = 2
insert_final_newline = false

[*.bat]
end_of_line = crlf
