#!/bin/sh
# Generated launcher for Backpack @TAG@. Checksum, version, and zip URL
# are hardcoded for this release. Pipe this file to sh.
set -e

TAG=@TAG@
VERSION=@VERSION@
UA=backpack-run

if [ "$(uname -s)" != Darwin ]; then
    echo "this script is for macOS" >&2
    exit 1
fi

if ! command -v curl >/dev/null; then
    echo "curl is required" >&2
    exit 1
fi

arch=$(uname -m)
case $arch in
    arm64|aarch64) arch=arm64 ;;
    x86_64) arch=x64 ;;
    *)
        echo "unsupported architecture: $arch" >&2
        exit 1
        ;;
esac

case $arch in
    arm64)
        url='@URL_MACOS_ARM64@'
        sha='@SHA_MACOS_ARM64@'
        asset='@ASSET_MACOS_ARM64@'
        ;;
    x64)
        url='@URL_MACOS_X64@'
        sha='@SHA_MACOS_X64@'
        asset='@ASSET_MACOS_X64@'
        ;;
esac

if [ -z "$url" ] || [ -z "$sha" ] || [ -z "$asset" ]; then
    echo "no macos-$arch build in Backpack $TAG" >&2
    exit 1
fi

cache_dir=${BACKPACK_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/backpack}
mkdir -p "$cache_dir"
zip="$cache_dir/$asset"

verify() {
    got=$(shasum -a 256 "$1")
    got=${got%% *}
    [ "$got" = "$sha" ]
}

if [ -f "$zip" ] && verify "$zip"; then
    echo "Using cached $asset"
else
    echo "Downloading Backpack $TAG (macos-$arch)"
    tmp=$(mktemp "$cache_dir/download.XXXXXX")
    trap 'rm -f "$tmp"' EXIT INT TERM HUP
    curl -fL -A "$UA" -o "$tmp" "$url"
    if ! verify "$tmp"; then
        got=$(shasum -a 256 "$tmp")
        got=${got%% *}
        echo "checksum mismatch for $asset" >&2
        echo "expected: $sha" >&2
        echo "actual:   $got" >&2
        exit 1
    fi
    mv -f "$tmp" "$zip"
    trap - EXIT INT TERM HUP
    echo "Checksum OK"
fi

app_dir="$cache_dir/$sha"
bin="$app_dir/backpack.app/Contents/MacOS/backpack"
if [ ! -x "$bin" ]; then
    rm -rf "$app_dir"
    tmp_dir=$(mktemp -d "$cache_dir/extract.XXXXXX")
    trap 'rm -rf "$tmp_dir"' EXIT INT TERM HUP
    ditto -x -k "$zip" "$tmp_dir"
    mv "$tmp_dir" "$app_dir"
    trap - EXIT INT TERM HUP
fi
if [ ! -x "$bin" ]; then
    echo "could not find $bin" >&2
    exit 1
fi

echo "Starting Backpack $TAG"
"$bin"
echo "Backpack exited"
