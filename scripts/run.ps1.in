# Generated launcher for Backpack @TAG@. Checksum, version, and zip URL
# are hardcoded for this release. Pipe this file to powershell.
$ErrorActionPreference = 'Stop'

$Tag = '@TAG@'
$Version = '@VERSION@'
$UA = 'backpack-run'
$urlWindowsX64 = '@URL_WINDOWS_X64@'
$shaWindowsX64 = '@SHA_WINDOWS_X64@'
$assetWindowsX64 = '@ASSET_WINDOWS_X64@'
$urlWindowsArm64 = '@URL_WINDOWS_ARM64@'
$shaWindowsArm64 = '@SHA_WINDOWS_ARM64@'
$assetWindowsArm64 = '@ASSET_WINDOWS_ARM64@'

if ($env:OS -ne 'Windows_NT') {
    throw 'this script is for Windows'
}

if (-not (Get-Command curl.exe -ErrorAction SilentlyContinue)) {
    throw 'curl.exe is required'
}

function Get-NativeArch {
    $name = $env:PROCESSOR_ARCHITECTURE
    try {
        $ri = [System.Runtime.InteropServices.RuntimeInformation]
        $name = $ri::OSArchitecture.ToString()
    } catch {
    }
    if ($name -match 'ARM64|Arm64') { return 'arm64' }
    if ($name -match 'AMD64|X64|x64') { return 'x64' }
    throw "unsupported architecture: $name"
}

$arch = Get-NativeArch
if ($arch -eq 'arm64') {
    $url = $urlWindowsArm64
    $sha = $shaWindowsArm64
    $asset = $assetWindowsArm64
} else {
    $url = $urlWindowsX64
    $sha = $shaWindowsX64
    $asset = $assetWindowsX64
}
if ((-not $url -or -not $sha -or -not $asset) -and $arch -eq 'arm64') {
    Write-Host 'no windows-arm64 asset, using windows-x64'
    $arch = 'x64'
    $url = $urlWindowsX64
    $sha = $shaWindowsX64
    $asset = $assetWindowsX64
}
if (-not $url -or -not $sha -or -not $asset) {
    throw "no windows-$arch build in Backpack $Tag"
}

$cacheDir = $env:BACKPACK_CACHE
if (-not $cacheDir) {
    $base = $env:LOCALAPPDATA
    if (-not $base) {
        $base = $env:TEMP
    }
    $cacheDir = Join-Path $base 'backpack\cache'
}
New-Item -ItemType Directory -Path $cacheDir -Force | Out-Null

function Test-Sha($file) {
    if (-not (Test-Path -LiteralPath $file)) {
        return $false
    }
    $got = (Get-FileHash -Path $file -Algorithm SHA256).Hash
    return $got.ToLowerInvariant() -eq $sha.ToLowerInvariant()
}

$exitCode = 0
try {
    $zip = Join-Path $cacheDir $asset
    if (Test-Sha $zip) {
        Write-Host "Using cached $asset"
    } else {
        Write-Host "Downloading Backpack $Tag (windows-$arch)"
        $dl = Join-Path $cacheDir ('download-' + [guid]::NewGuid().ToString('N'))
        & curl.exe -fL -A $UA -o $dl $url
        if ($LASTEXITCODE -ne 0) {
            Remove-Item -LiteralPath $dl -Force -ErrorAction SilentlyContinue
            throw "failed to download $asset"
        }
        if (-not (Test-Sha $dl)) {
            $got = (Get-FileHash -Path $dl -Algorithm SHA256).Hash
            $got = $got.ToLowerInvariant()
            Remove-Item -LiteralPath $dl -Force -ErrorAction SilentlyContinue
            throw "checksum mismatch for $asset`nexpected: $sha`nactual:   $got"
        }
        Move-Item -LiteralPath $dl -Destination $zip -Force
        Write-Host 'Checksum OK'
    }

    $appDir = Join-Path $cacheDir $sha
    $exe = Join-Path $appDir 'backpack\backpack.exe'
    if (-not (Test-Path -LiteralPath $exe)) {
        if (Test-Path -LiteralPath $appDir) {
            Remove-Item -LiteralPath $appDir -Recurse -Force
        }
        $ex = Join-Path $cacheDir ('extract-' + [guid]::NewGuid().ToString('N'))
        New-Item -ItemType Directory -Path $ex | Out-Null
        Push-Location $ex
        try {
            & tar.exe -xf $zip
            if ($LASTEXITCODE -ne 0) {
                throw "failed to extract $asset"
            }
        } finally {
            Pop-Location
        }
        Move-Item -LiteralPath $ex -Destination $appDir
    }
    if (-not (Test-Path -LiteralPath $exe)) {
        throw "could not find $exe"
    }

    Write-Host "Starting Backpack $Tag"
    $dir = Split-Path -Parent $exe
    $proc = Start-Process -FilePath $exe -WorkingDirectory $dir -Wait `
        -PassThru
    if ($null -ne $proc) {
        $exitCode = $proc.ExitCode
    }
    Write-Host 'Backpack exited'
} catch {
    [Console]::Error.WriteLine($_.Exception.Message)
    $exitCode = 1
}

exit $exitCode
